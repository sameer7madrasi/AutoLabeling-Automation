# Copy this file to .env and fill in your tenant values.
# NEVER put a password in here - authentication is completed manually in the browser.

# Microsoft 365 test user. The email is sent FROM this mailbox TO this mailbox.
TEST_USER_EMAIL=autolabel.tester@contoso.onmicrosoft.com

# Outlook Web entry point.
OUTLOOK_URL=https://outlook.office.com/mail/

# Sensitivity label the existing Auto-Labeling policy is expected to apply.
EXPECTED_LABEL=EnforcementTest-Label

# Text that triggers the sensitive information type used by the policy.
SIT_TRIGGER=SingleLocationScope-Enforcement-SIT

# --- Optional tuning (defaults shown) ---

# How long to wait for the message to show up in the inbox.
EMAIL_ARRIVAL_TIMEOUT_MINUTES=10

# How long to wait for Auto-Labeling to stamp the sensitivity label.
LABEL_TIMEOUT_MINUTES=10

# Polling interval used while waiting for the email and the label.
POLL_INTERVAL_SECONDS=20

# How long the tester has to complete Microsoft login / MFA in the opened browser.
LOGIN_TIMEOUT_MINUTES=5

# Set to true to print sensitivity-label DOM candidates (useful when tuning locators).
DEBUG_LABEL_LOCATOR=false
